# Configuración del Servidor
PORT=8080
NODE_ENV=development

# Configuración de Base de Datos (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=complif_challenge
DB_HOST=localhost
DB_PORT=5432

# Seguridad y Autenticación
JWT_SECRET=una_clave_secreta_muy_larga_y_segura
JWT_EXPIRES_IN=8h

# Microservicios (Configuración para Docker)
# Nota: En Docker se usa el nombre del servicio definido en docker-compose.yml
CUIT_VALIDATOR_URL=http://cuit-validator:3001/validate-cuit

# Logs
LOG_LEVEL=info