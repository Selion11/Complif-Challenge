{
	"info": {
		"name": "Complif Challenge",
		"description": "Suite completa automatizada corregida: Onboarding, Riesgos, Reglas y Motor de Firmas.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Setup & Auth",
			"item": [
				{
					"name": "Registrar Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Registro exitoso\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200, 400]); // 400 por si ya existe",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_entregable\",\n    \"password\": \"password123\",\n    \"cuit_empresa\": \"30111111118\",\n    \"role\": \"admin\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/auth/signup",
							"host": ["{{base_url}}"],
							"path": ["auth", "signup"]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"pm.test(\"Login exitoso y Token guardado\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    pm.expect(response.token).to.not.be.undefined;",
									"    pm.collectionVariables.set(\"token\", response.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_entregable\",\n    \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Gestión de Empresas",
			"item": [
				{
					"name": "Listar Empresas",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Listado obtenido\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    pm.expect(pm.response.json().data).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/companies?country=Argentina",
							"host": ["{{base_url}}"],
							"path": ["companies"],
							"query": [{ "key": "country", "value": "Argentina" }]
						}
					}
				},
				{
					"name": "Verificar Risk Score",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Risk Score obtenido\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"    pm.expect(pm.response.json().data.riskScore).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/companies/30222222228/risk-score",
							"host": ["{{base_url}}"],
							"path": ["companies", "30222222228", "risk-score"]
						}
					}
				},
				{
					"name": "Actualizar Estado (Aprobar)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Estado actualizado\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"APPROVED\",\n    \"comment\": \"Legajo verificado manualmente\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/companies/30222222228/status",
							"host": ["{{base_url}}"],
							"path": ["companies", "30222222228", "status"]
						}
					}
				}
			]
		},
		{
			"name": "3. Motor de Facultades",
			"item": [
				{
					"name": "Crear Grupo",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"pm.test(\"Grupo creado e ID capturado\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
									"    pm.expect(response.data.id).to.not.be.undefined;",
									"    pm.collectionVariables.set(\"groupId\", response.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Directores Legales\",\n    \"cuit_empresa\": \"30111111118\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/groups",
							"host": ["{{base_url}}"],
							"path": ["groups"]
						}
					}
				},
				{
					"name": "Definir Regla",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Regla creada correctamente\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cuit_empresa\": \"30111111118\",\n    \"nombre_regla\": \"REQUEST_LOAN\",\n    \"id_grupo\": \"{{groupId}}\",\n    \"cantidad_requerida\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/rules",
							"host": ["{{base_url}}"],
							"path": ["rules"]
						}
					}
				}
			]
		},
		{
			"name": "4. Proceso de Firma",
			"item": [
				{
					"name": "Crear Solicitud",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"pm.test(\"Solicitud creada e ID capturado\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
									"    pm.expect(response.data.id).to.not.be.undefined;",
									"    pm.collectionVariables.set(\"requestId\", response.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cuit_empresa\": \"30111111118\",\n    \"accion\": \"REQUEST_LOAN\",\n    \"descripcion\": \"Préstamo solicitado por Administración\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/requests",
							"host": ["{{base_url}}"],
							"path": ["requests"]
						}
					}
				},
				{
					"name": "Firmar Solicitud",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Firma registrada\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{base_url}}/requests/{{requestId}}/sign",
							"host": ["{{base_url}}"],
							"path": ["requests", "{{requestId}}", "sign"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080/api" },
		{ "key": "token", "value": "" },
		{ "key": "groupId", "value": "" },
		{ "key": "requestId", "value": "" }
	]
}